{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpknowledge.local/schemas/event/v1",
  "title": "DomainEvent",
  "type": "object",
  "required": ["schemaVersion", "eventId", "eventType", "runId", "occurredAt", "causationId", "payload"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "eventId": {"type": "string", "minLength": 1},
    "eventType": {"enum": ["RunCreated", "NodeStarted", "ArtifactCommitted", "EvaluationCompleted", "CorrectionProposed", "GateDecided", "KnowledgePublished", "RunTerminated", "AccessDenied"]},
    "runId": {"type": "string", "minLength": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "causationId": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
