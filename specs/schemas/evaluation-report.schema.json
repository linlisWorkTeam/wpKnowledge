{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpknowledge.local/schemas/evaluation-report/v1",
  "title": "EvaluationReport",
  "type": "object",
  "required": ["schemaVersion", "reportId", "runId", "iteration", "inputRefs", "policyVersion", "toolchainFingerprint", "compile", "criticalResults", "repetitions", "stability"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "reportId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "inputRefs": {"type": "array", "minItems": 1, "items": {"$ref": "artifact-ref.schema.json"}},
    "policyVersion": {"type": "string", "minLength": 1},
    "toolchainFingerprint": {"type": "string", "minLength": 1},
    "compile": {"enum": ["PASS", "FAIL"]},
    "criticalResults": {"type": "array", "items": {"type": "object", "required": ["caseId", "status"], "properties": {"caseId": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "ERROR"]}}, "additionalProperties": false}},
    "repetitions": {"type": "array", "minItems": 5, "items": {"type": "object"}},
    "stability": {"enum": ["STABLE", "UNSTABLE"]},
    "scoreComponents": {"type": "object"},
    "reasonCodes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
