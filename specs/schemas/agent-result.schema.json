{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpknowledge.local/schemas/agent-result/v1",
  "title": "AgentResult",
  "type": "object",
  "required": ["schemaVersion", "commandId", "runId", "agentType", "status", "outputRefs", "payload"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "commandId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "agentType": {"enum": ["orchestrator", "docgen", "docworker", "testgen", "codegen", "check", "review"]},
    "status": {"enum": ["SUCCEEDED", "FAILED"]},
    "outputRefs": {"type": "array", "items": {"$ref": "artifact-ref.schema.json"}},
    "payload": {
      "type": "object",
      "properties": {
        "resultKind": {"enum": ["plan", "knowledgeCandidate", "knowledgeChunk", "testCandidates", "codeArtifact", "findings", "attribution", "error"]},
        "corrections": {"type": "array", "items": {"$ref": "correction.schema.json"}},
        "unresolvedRisks": {"type": "array", "items": {"type": "string"}},
        "errorCode": {"type": "string"}
      },
      "required": ["resultKind"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
