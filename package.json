{
  "name": "@linlis-workteam/wpknowledge-flywheel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "knowledge": "node endlessWpKnowledgeRunner/apps/runner/src/cli.ts",
    "knowledge:serve": "node endlessWpKnowledgeRunner/apps/runner/src/server.ts",
    "site:serve": "node endlessWpKnowledgeRunner/site/dev-server.mjs",
    "site:check": "node --test endlessWpKnowledgeRunner/tests/contract/site.test.ts",
    "acceptance:ohmyworkpanel": "node endlessWpKnowledgeRunner/apps/runner/src/project-acceptance.ts",
    "test": "node --test --test-concurrency=1",
    "test:architecture": "node --test endlessWpKnowledgeRunner/tests/contract/architecture.test.ts",
    "test:domain": "node --test endlessWpKnowledgeRunner/tests/unit",
    "test:integration": "node --test --test-concurrency=1 endlessWpKnowledgeRunner/tests/integration",
    "test:acceptance": "node --test --test-concurrency=1 endlessWpKnowledgeRunner/tests/acceptance",
    "typecheck": "tsc --noEmit",
    "validate:specs": "node endlessWpKnowledgeRunner/specs/13-verification/validate-specs.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-sdk-client": "0.1.2-alpha.4",
    "@langchain/langgraph": "1.4.13",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
